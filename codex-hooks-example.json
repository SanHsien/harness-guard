{
  "_comment": "Codex 版。把需要的區塊併進你的 ~/.codex/hooks.json，並確認 ~/.codex/config.toml 裡有 hooks = true。已有同名事件就把 hooks 陣列的內容加進去，不要整段覆蓋。Codex 對 hook 有信任機制，第一次啟用會要你確認。註冊後重開 session 才生效。",
  "_note_matcher": "matcher 同時寫兩邊的工具名是刻意的。Codex 改檔案叫 apply_patch、執行指令叫 exec 或 shell，但不同版本與不同設定下也可能出現 Write / Edit / Bash，寫寬一點比漏掉安全。",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch|Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.codex/hooks/no-emoji-guard.py",
            "timeout": 10
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Bash|Grep|Glob|exec|shell",
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/claim-ledger-tracker.sh",
            "timeout": 5
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.codex/hooks/claim-evidence-guard.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "LINT_CMD='npm run lint' FAIL_PATTERN='[1-9][0-9]* error' ~/.codex/hooks/lint-gate.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
